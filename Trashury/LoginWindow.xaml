<Window x:Class="Trashury.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login — TRASHURY"
        Height="360" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7F5">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TRASHURY" FontSize="24" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center"/>
            <TextBlock Text="Masuk dengan akun Operator atau Pengurus" FontSize="12" Foreground="#4E6B52" HorizontalAlignment="Center" Margin="0,2,0,18"/>

            <TextBlock Text="Username:" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <TextBox x:Name="UsernameBox" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Password:" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,0,0,14"/>

            <Button Content="Masuk" IsDefault="True" Click="Masuk_Click"
                    Padding="12,9" Background="#1B5E20" Foreground="White" FontWeight="Bold" Cursor="Hand"/>

            <Border Background="#E8F5E9" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                <TextBlock Text="Akun bawaan:&#x0a;• Pengurus: pengurus / pengurus123&#x0a;• Operator: operator / operator123"
                           FontSize="11" Foreground="#1B5E20"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
