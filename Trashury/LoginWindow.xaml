<Window x:Class="Trashury.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRASHURY — Login"
        Icon="pack://application:,,,/Assets/trashury.ico"
        Height="760" Width="1200" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="#F3F7F4">
    <DockPanel>
        <!-- Header konsisten dengan MainWindow -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradientBrush}" Padding="22,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="8" ClipToBounds="True" Width="38" Height="38" Margin="0,0,12,0" BorderBrush="#4CAF50" BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/trashury-icon.png" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="TRASHURY" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Kartu Login di Tengah -->
        <Grid>
            <Border Background="White"
                    BorderBrush="#DCE5DF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Width="420"
                    Padding="36"
                    Effect="{StaticResource CardShadow}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border CornerRadius="14" ClipToBounds="True" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Image Source="pack://application:,,,/Assets/trashury-icon.png" Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock Text="Masuk ke TRASHURY" FontSize="22" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Silakan masuk dengan akun Pengurus atau Operator" FontSize="12.5" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                    <TextBlock Text="Username" FontSize="12.5" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,14"/>

                    <TextBlock Text="Password" FontSize="12.5" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,22"/>

                    <Button Content="Masuk" IsDefault="True" Click="Masuk_Click"
                            Padding="14,11" Background="#1B5E20" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
