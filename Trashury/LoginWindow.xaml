<Window x:Class="Trashury.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRASHURY — Login Sistem Manajemen Bank Sampah"
        Height="760" Width="1200" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F3F7F4">
    <DockPanel>
        <!-- Header konsisten dengan MainWindow -->
        <Border DockPanel.Dock="Top" Background="#1B5E20" Padding="20,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TRASHURY" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Ubah sampah jadi harta, kelola bank sampah lebih rapi (Hybrid Cloud-Edge)" FontSize="12" Foreground="#C8E6C9"/>
            </StackPanel>
        </Border>

        <!-- Kartu Login di Tengah -->
        <Grid>
            <Border Background="White"
                    BorderBrush="#DCE5DF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="420"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Masuk ke TRASHURY" FontSize="22" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Gunakan akun Pengurus atau Operator Bank Sampah" FontSize="12" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,4,0,22"/>

                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#455A64" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameBox" Padding="10,8" Margin="0,0,0,14"/>

                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#455A64" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Padding="10,8" Margin="0,0,0,18"/>

                    <Button Content="Masuk" IsDefault="True" Click="Masuk_Click"
                            Padding="14,10" Background="#1B5E20" Foreground="White" FontWeight="Bold" FontSize="14"/>

                    <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                        <TextBlock Text="Akun bawaan:&#x0a;• Pengurus (Akses Penuh): pengurus / pengurus123&#x0a;• Operator (Meja Setoran): operator / operator123"
                                   FontSize="12" Foreground="#1B5E20"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
