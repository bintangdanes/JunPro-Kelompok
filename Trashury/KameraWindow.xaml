<Window x:Class="Trashury.KameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pratinjau Kamera — TRASHURY"
        Icon="pack://application:,,,/Assets/trashury.ico"
        Height="480" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Batal" Click="Batal_Click" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="Ambil Foto &amp; Klasifikasi" Click="Ambil_Click"
                    Padding="16,8" Background="#2E7D32" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Background="Black" CornerRadius="6" ClipToBounds="True">
            <Image x:Name="PreviewKamera" Stretch="Uniform"/>
        </Border>
    </DockPanel>
</Window>
