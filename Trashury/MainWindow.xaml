<Window x:Class="Trashury.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRASHURY — Sistem Manajemen Bank Sampah &amp; Dampak Iklim"
        Icon="pack://application:,,,/Assets/trashury.ico"
        Height="760" Width="1200" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="#F3F7F4">

    <DockPanel>
        <!-- Header Utama -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradientBrush}" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" ClipToBounds="True" Width="38" Height="38" Margin="0,0,12,0" BorderBrush="#4CAF50" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/trashury-icon.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRASHURY" FontSize="21" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Ubah sampah jadi harta, kelola bank sampah lebih rapi (Hybrid Cloud-Edge)" FontSize="12" Foreground="#C8E6C9"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#2E7D32" CornerRadius="16" Padding="13,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" FontSize="13" Foreground="#C8E6C9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding NamaPeranAktif}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding LogoutCommand}" Padding="14,7" Background="#FFFFFF" Foreground="#1B5E20" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7E8;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Logout / Ganti Akun" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Konten Tab -->
        <TabControl Margin="16,12,16,16">
            <!-- TAB 1: DASHBOARD DAMPAK IKLIM & LAPORAN BULANAN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Dashboard Iklim &amp; Laporan DLH" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="0,10,10,10" Padding="20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filter Bulan & Tahun + Tombol Ekspor -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bulan:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#37474F" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding DaftarBulan}"
                                          SelectedValue="{Binding BulanLaporan}"
                                          SelectedValuePath="Nomor"
                                          DisplayMemberPath="Nama"
                                          Width="140" Margin="0,0,14,0"/>
                                <TextBlock Text="Tahun:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#37474F" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding TahunLaporan}" Width="78" Margin="0,0,12,0"/>
                                <Button Content="Muat Rekap" Command="{Binding MuatLaporanCommand}" Background="#1B5E20" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsPengurus, Converter={StaticResource BoolToVis}}">
                                <Button Command="{Binding EksporCsvCommand}" Background="#0277BD" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ekspor CSV" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding EksporPdfCommand}" Background="#C62828" Foreground="White" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ekspor PDF (DLH)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Kartu Ringkasan Climate Action -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                            <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Estimasi CO2e Dihindari" Foreground="#2E7D32" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalEmisiDashboard}" FontSize="23" FontWeight="Bold" Foreground="#1B5E20"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" FontSize="14" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Total Sampah Terkumpul" Foreground="#1565C0" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalBeratDashboard}" FontSize="23" FontWeight="Bold" Foreground="#0D47A1"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF8E1" BorderBrush="#FFECB3" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C7;" FontSize="14" Foreground="#EF6C00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Total Nilai Setoran" Foreground="#EF6C00" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalSetoranDashboard}" FontSize="23" FontWeight="Bold" Foreground="#E65100"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FCE4EC" BorderBrush="#F8BBD0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AB;" FontSize="14" Foreground="#AD1457" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Total Penarikan Saldo" Foreground="#AD1457" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalPenarikanDashboard}" FontSize="23" FontWeight="Bold" Foreground="#880E4F"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Tabel Rincian + Grafik Kontribusi CO2e -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid Grid.Column="0" ItemsSource="{Binding RincianLaporan}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,14,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kategori Sampah" Binding="{Binding NamaKategori}" Width="*"/>
                                    <DataGridTextColumn Header="Total Berat (kg)" Binding="{Binding TotalBeratKg, StringFormat=N2}" Width="125"/>
                                    <DataGridTextColumn Header="Total Nilai (Rp)" Binding="{Binding TotalNilai, StringFormat=N0}" Width="135"/>
                                    <DataGridTextColumn Header="CO2e (kg)" Binding="{Binding TotalCO2eKg, StringFormat=N2}" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Column="1" Background="#F9FBF9" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="10" Padding="16">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D2;" FontSize="15" Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Grafik Kontribusi Reduksi CO2e" FontSize="14.5" FontWeight="Bold" Foreground="#1B5E20"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DataGrafikEmisi}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,13">
                                                        <DockPanel Margin="0,0,0,5">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding NamaKategori}" FontWeight="SemiBold" FontSize="12.5" Foreground="#263238"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalCO2eKg, StringFormat='{}{0:N2} kg CO2e'}" FontSize="12.5" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                                        </DockPanel>
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Persentase}" Height="12" Foreground="#2E7D32" Background="#E4F0E6"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: TRANSAKSI SETORAN SAMPAH + AI -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BF;" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Transaksi Setoran Sampah" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="10" Padding="20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="385"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel Input Setoran -->
                        <Border Grid.Column="0" Background="#F9FBF9" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,16,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Input Setoran Baru" FontSize="16.5" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,14"/>

                                    <TextBlock Text="Pilih Nasabah" FontWeight="SemiBold" FontSize="12.5" Foreground="#37474F" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding DaftarNasabah}" SelectedItem="{Binding NasabahSetoranTerpilih}"
                                              DisplayMemberPath="Nama" Margin="0,0,0,14"/>

                                    <!-- Panel Klasifikasi AI Otomatis -->
                                    <Border Background="#EDF7EE" BorderBrush="#C8E6C9" BorderThickness="1" Padding="13" CornerRadius="10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE99A;" FontSize="14" Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Klasifikasi Foto Sampah (AI)" FontWeight="Bold" Foreground="#1B5E20" FontSize="13.5"/>
                                            </StackPanel>
                                            <TextBlock Text="Otomatis Cloud SigLIP (online) • ONNX lokal (offline)" FontSize="11.5" Foreground="#388E3C" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding KlasifikasiFotoCommand}" Background="White" Foreground="#1B5E20" BorderBrush="#A5D6A7" BorderThickness="1" FontWeight="SemiBold" Margin="0,0,4,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEB9F;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Pilih Foto..." VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Command="{Binding KlasifikasiKameraCommand}" Background="#2E7D32" Foreground="White" FontWeight="SemiBold" Margin="4,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE722;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Ambil Kamera" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Image Source="{Binding PreviewGambarAi}" MaxHeight="140" Stretch="Uniform" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding HasilPrediksiAi}" TextWrapping="Wrap" FontSize="12" Foreground="#1B5E20" LineHeight="17"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Kategori Sampah" FontWeight="SemiBold" FontSize="12.5" Foreground="#37474F" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding DaftarKategori}" SelectedItem="{Binding KategoriSetoranTerpilih}"
                                              DisplayMemberPath="Nama" Margin="0,0,0,12"/>

                                    <TextBlock Text="Berat Sampah (kg)" FontWeight="SemiBold" FontSize="12.5" Foreground="#37474F" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding BeratSetoranInput}" Margin="0,0,0,16"/>

                                    <Button Content="+ Tambah ke Daftar Setoran" Command="{Binding TambahBarisSetoranCommand}"
                                            Padding="12,10" Background="#0277BD" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Panel Keranjang & Simpan Transaksi -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding KeranjangSetoran}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori.Nama}" Width="*"/>
                                    <DataGridTextColumn Header="Harga/kg" Binding="{Binding Kategori.HargaPerKg, StringFormat=N0}" Width="115"/>
                                    <DataGridTextColumn Header="Berat (kg)" Binding="{Binding BeratKg, StringFormat=N2}" Width="95"/>
                                    <DataGridTextColumn Header="Subtotal (Rp)" Binding="{Binding Subtotal, StringFormat=N0}" Width="130"/>
                                    <DataGridTemplateColumn Header="Aksi" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Hapus" Padding="8,3" FontSize="12" Background="#C62828" Foreground="White"
                                                        Command="{Binding DataContext.HapusBarisSetoranCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1" Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" Padding="18,14" CornerRadius="10" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding TotalNominalKeranjang, StringFormat='Total Pendapatan: Rp {0:N0}'}" FontSize="18.5" FontWeight="Bold" Foreground="#1B5E20"/>
                                        <TextBlock Text="{Binding TotalEmisiKeranjang, StringFormat='Estimasi Reduksi Emisi: {0:N2} kg CO2e'}" FontSize="13" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Simpan Transaksi Setoran" Command="{Binding SimpanSetoranCommand}"
                                            Padding="22,12" Background="#1B5E20" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: PENARIKAN SALDO & BUKU TABUNGAN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C7;" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Penarikan Saldo &amp; Buku Tabungan" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="10" Padding="20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="365"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F9FBF9" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Penarikan Tabungan Nasabah" FontSize="16.5" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,14"/>

                                <TextBlock Text="Pilih Nasabah" FontWeight="SemiBold" FontSize="12.5" Foreground="#37474F" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding DaftarNasabah}" SelectedItem="{Binding NasabahTarikTerpilih}"
                                          DisplayMemberPath="Nama" Margin="0,0,0,12"/>

                                <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding NasabahTarikTerpilih.Saldo, StringFormat='Saldo Tersedia: Rp {0:N0}'}"
                                               FontSize="16.5" FontWeight="Bold" Foreground="#1B5E20"/>
                                </Border>

                                <TextBlock Text="Jumlah Penarikan (Rp)" FontWeight="SemiBold" FontSize="12.5" Foreground="#37474F" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NominalTarikInput}" Margin="0,0,0,16"/>

                                <Button Content="Proses Penarikan Saldo" Command="{Binding ProsesPenarikanCommand}"
                                        Padding="12,10" Background="#C62828" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Button Command="{Binding CetakBukuTabunganPdfCommand}" Padding="12,10" Background="#37474F" Foreground="White" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Cetak Buku Tabungan (PDF)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1D272B" CornerRadius="10" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding RingkasanBukuTabungan}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#ECEFF1" LineHeight="20"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: RIWAYAT TRANSAKSI GLOBAL & PEMBATALAN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81C;" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Riwayat Transaksi" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="10" Padding="20" Effect="{StaticResource CardShadow}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Filter Jenis:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#37474F" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding PilihanFilterJenis}" SelectedItem="{Binding FilterJenisRiwayat}" Width="135" Margin="0,0,16,0"/>
                            <TextBlock Text="Cari (Nasabah / ID):" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#37474F" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding KataKunciRiwayat, UpdateSourceTrigger=PropertyChanged}" Width="270"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding DaftarRiwayatTransaksi}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/>
                                <DataGridTextColumn Header="Nasabah" Binding="{Binding NamaNasabah}" Width="160"/>
                                <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="90"/>
                                <DataGridTextColumn Header="Rincian" Binding="{Binding Rincian}" Width="*"/>
                                <DataGridTextColumn Header="Nominal (Rp)" Binding="{Binding Nominal, StringFormat=N0}" Width="115"/>
                                <DataGridTemplateColumn Header="Aksi" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Bukti" Padding="8,3" FontSize="12" Margin="0,0,4,0" Background="#0277BD" Foreground="White"
                                                        Visibility="{Binding IsSetoran, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.CetakUlangBuktiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Batalkan" Padding="8,3" FontSize="12" Background="#C62828" Foreground="White"
                                                        Visibility="{Binding DataContext.IsPengurus, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.BatalkanTransaksiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- TAB 5: MASTER DATA (KHUSUS PENGURUS BANK SAMPAH) -->
            <TabItem Visibility="{Binding IsPengurus, Converter={StaticResource BoolToVis}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Master Data (Pengurus)" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="10" Padding="20" Effect="{StaticResource CardShadow}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Background="#F3F7F4" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" FontSize="14" Foreground="#37474F" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Pemeliharaan Basis Data Lokal (SQLite)" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Cadangkan Database (.db)" Command="{Binding BackupDatabaseCommand}" Background="#37474F" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <Button Content="Pulihkan Database (.db)" Command="{Binding RestoreDatabaseCommand}" Background="#E65100" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kolom Kiri: Master Nasabah -->
                            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Kelola Data Nasabah" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NamaNasabahBaru}" ToolTip="Masukkan nama lengkap nasabah" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Tambah" Command="{Binding TambahNasabahCommand}" Padding="10,6" Background="#2E7D32" Foreground="White" Margin="0,0,4,0"/>
                                            <Button Content="Ubah" Command="{Binding UbahNasabahCommand}" Padding="10,6" Background="#0277BD" Foreground="White" Margin="0,0,4,0"/>
                                            <Button Content="Hapus" Command="{Binding HapusNasabahCommand}" Padding="10,6" Background="#C62828" Foreground="White" Margin="0,0,4,0"/>
                                            <Button Content="Reset" Command="{Binding ResetNasabahCommand}" Padding="10,6" Background="#607D8B" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Cari (Nama / ID):" VerticalAlignment="Center" FontSize="12.5" Foreground="#546E7A" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding KataKunciCariNasabah, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ketik nama atau ID nasabah untuk memfilter tabel"/>
                                    </Grid>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding DaftarNasabahMaster}" SelectedItem="{Binding NasabahMasterTerpilih}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                                        <DataGridTextColumn Header="Nama Nasabah" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="Saldo (Rp)" Binding="{Binding Saldo, StringFormat=N0}" Width="125"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- Kolom Kanan: Master Kategori Sampah -->
                            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Kelola Kategori Sampah" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NamaKategoriBaru}" Margin="0,0,4,0" ToolTip="Nama Kategori"/>
                                        <TextBox Grid.Column="1" Text="{Binding HargaKategoriBaru}" Margin="0,0,4,0" ToolTip="Harga/kg"/>
                                        <TextBox Grid.Column="2" Text="{Binding EmisiKategoriBaru}" Margin="0,0,6,0" ToolTip="Faktor Emisi CO2e"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="+" Command="{Binding TambahKategoriCommand}" Padding="10,6" Background="#2E7D32" Foreground="White" ToolTip="Tambah Kategori" Margin="0,0,3,0"/>
                                            <Button Content="Ubah" Command="{Binding UbahKategoriCommand}" Padding="9,6" Background="#0277BD" Foreground="White" Margin="0,0,3,0"/>
                                            <Button Content="Hapus" Command="{Binding HapusKategoriCommand}" Padding="9,6" Background="#C62828" Foreground="White" Margin="0,0,3,0"/>
                                            <Button Content="Reset" Command="{Binding ResetKategoriCommand}" Padding="9,6" Background="#607D8B" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding DaftarKategori}" SelectedItem="{Binding KategoriMasterTerpilih}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kategori" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="Harga/kg" Binding="{Binding HargaPerKg, StringFormat=N0}" Width="110"/>
                                        <DataGridTextColumn Header="Emisi CO2e" Binding="{Binding FaktorEmisiCO2e, StringFormat=N2}" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
