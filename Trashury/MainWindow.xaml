<Window x:Class="Trashury.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Trashury.ViewModels"
        Title="TRASHURY — Sistem Manajemen Bank Sampah &amp; Dampak Iklim"
        Height="720" Width="1120" WindowStartupLocation="CenterScreen"
        Background="#F4F7F5">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Header Utama -->
        <Border DockPanel.Dock="Top" Background="#1B5E20" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="TRASHURY" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Ubah sampah jadi harta, kelola bank sampah lebih rapi (Offline-First)" FontSize="12" Foreground="#C8E6C9"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NamaPeranAktif}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Ganti Peran (Operator / Pengurus)" Command="{Binding GantiPeranCommand}"
                            Padding="12,6" Background="#388E3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Konten Tab 6 Fitur Utama -->
        <TabControl Margin="12" Background="White">
            <!-- TAB 1: DASHBOARD DAMPAK IKLIM & LAPORAN BULANAN -->
            <TabItem Header="Dashboard Iklim &amp; Laporan DLH">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bulan & Tahun + Tombol Ekspor (Khusus Pengurus) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Bulan (1-12):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding BulanLaporan}" Width="50" Padding="4" Margin="0,0,12,0"/>
                        <TextBlock Text="Tahun:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding TahunLaporan}" Width="70" Padding="4" Margin="0,0,12,0"/>
                        <Button Content="Muat Rekap" Command="{Binding MuatLaporanCommand}" Padding="12,5" Background="#2E7D32" Foreground="White" Margin="0,0,16,0"/>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsPengurus, Converter={StaticResource BoolToVis}}">
                            <Button Content="Ekspor CSV" Command="{Binding EksporCsvCommand}" Padding="12,5" Background="#0277BD" Foreground="White" Margin="0,0,8,0"/>
                            <Button Content="Ekspor PDF (DLH)" Command="{Binding EksporPdfCommand}" Padding="12,5" Background="#C62828" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Kartu Ringkasan Climate Action -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                        <Border Background="#E8F5E9" CornerRadius="8" Padding="14" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Estimasi CO2e Dihindari" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalEmisiDashboard}" FontSize="20" FontWeight="Bold" Foreground="#1B5E20" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="14" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Total Sampah Terkumpul" Foreground="#1565C0" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalBeratDashboard}" FontSize="20" FontWeight="Bold" Foreground="#0D47A1" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF8E1" CornerRadius="8" Padding="14" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Total Nilai Setoran" Foreground="#F57F17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalSetoranDashboard}" FontSize="20" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FCE4EC" CornerRadius="8" Padding="14" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Total Penarikan Saldo" Foreground="#AD1457" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalPenarikanDashboard}" FontSize="20" FontWeight="Bold" Foreground="#880E4F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Tabel Rincian per Kategori -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding RincianLaporan}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategori Sampah" Binding="{Binding NamaKategori}" Width="*"/>
                            <DataGridTextColumn Header="Total Berat (kg)" Binding="{Binding TotalBeratKg, StringFormat=N2}" Width="150"/>
                            <DataGridTextColumn Header="Total Nilai (Rp)" Binding="{Binding TotalNilai, StringFormat=N0}" Width="180"/>
                            <DataGridTextColumn Header="Emisi CO2e Dihindari (kg)" Binding="{Binding TotalCO2eKg, StringFormat=N2}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: TRANSAKSI SETORAN SAMPAH + AI ONNX -->
            <TabItem Header="Transaksi Setoran Sampah">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel Input Setoran -->
                    <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Input Setoran Baru" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Pilih Nasabah:" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DaftarNasabah}" SelectedItem="{Binding NasabahSetoranTerpilih}"
                                      DisplayMemberPath="Nama" Padding="6" Margin="0,0,0,12"/>

                            <Border Background="#E8F5E9" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Klasifikasi Foto Sampah (AI ONNX)" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                    <Button Content="Pilih Foto Sampah..." Command="{Binding KlasifikasiFotoCommand}" Margin="0,6,0,6" Padding="8,5"/>
                                    <TextBlock Text="{Binding HasilPrediksiAi}" TextWrapping="Wrap" FontSize="12" Foreground="#2E7D32"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Kategori Sampah:" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DaftarKategori}" SelectedItem="{Binding KategoriSetoranTerpilih}"
                                      DisplayMemberPath="Nama" Padding="6" Margin="0,0,0,10"/>

                            <TextBlock Text="Berat Sampah (kg):" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding BeratSetoranInput}" Padding="6" Margin="0,0,0,12"/>

                            <Button Content="+ Tambah ke Daftar Setoran" Command="{Binding TambahBarisSetoranCommand}"
                                    Padding="10,8" Background="#0277BD" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Panel Keranjang & Simpan Transaksi -->
                    <DockPanel Grid.Column="1">
                        <Border DockPanel.Dock="Bottom" Background="#E8F5E9" Padding="12" CornerRadius="6" Margin="0,12,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding TotalNominalKeranjang, StringFormat='Total Pendapatan: Rp {0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#1B5E20"/>
                                    <TextBlock Text="{Binding TotalEmisiKeranjang, StringFormat='Estimasi Reduksi Emisi: {0:N2} kg CO2e'}" Foreground="#2E7D32"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Simpan Transaksi Setoran" Command="{Binding SimpanSetoranCommand}"
                                        Padding="16,10" Background="#1B5E20" Foreground="White" FontWeight="Bold"/>
                            </DockPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding KeranjangSetoran}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori.Nama}" Width="*"/>
                                <DataGridTextColumn Header="Harga/kg" Binding="{Binding Kategori.HargaPerKg, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="Berat (kg)" Binding="{Binding BeratKg, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Subtotal (Rp)" Binding="{Binding Subtotal, StringFormat=N0}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: PENARIKAN SALDO & BUKU TABUNGAN -->
            <TabItem Header="Penarikan Saldo &amp; Buku Tabungan">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Penarikan Tabungan Nasabah" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Pilih Nasabah:" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DaftarNasabah}" SelectedItem="{Binding NasabahTarikTerpilih}"
                                      DisplayMemberPath="Nama" Padding="6" Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding NasabahTarikTerpilih.Saldo, StringFormat='Saldo Tersedia: Rp {0:N0}'}"
                                       FontSize="15" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,14"/>

                            <TextBlock Text="Jumlah Penarikan (Rp):" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NominalTarikInput}" Padding="6" Margin="0,0,0,12"/>

                            <Button Content="Proses Penarikan Saldo" Command="{Binding ProsesPenarikanCommand}"
                                    Padding="10,8" Background="#C62828" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Button Content="Cetak Buku Tabungan (PDF)" Command="{Binding CetakBukuTabunganPdfCommand}"
                                    Padding="10,8" Background="#37474F" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#263238" CornerRadius="6" Padding="14">
                        <ScrollViewer>
                            <TextBlock Text="{Binding RingkasanBukuTabungan}" FontFamily="Consolas" FontSize="13" Foreground="#ECEFF1"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: MASTER DATA (KHUSUS PENGURUS BANK SAMPAH) -->
            <TabItem Header="Master Data (Pengurus)" Visibility="{Binding IsPengurus, Converter={StaticResource BoolToVis}}">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kolom Kiri: Master Nasabah -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Kelola Data Nasabah" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Tambah Nasabah" Command="{Binding TambahNasabahCommand}"
                                        Padding="12,6" Background="#2E7D32" Foreground="White" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding NamaNasabahBaru}" Padding="6" ToolTip="Masukkan nama lengkap nasabah baru"/>
                            </DockPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding DaftarNasabah}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                <DataGridTextColumn Header="Nama Nasabah" Binding="{Binding Nama}" Width="*"/>
                                <DataGridTextColumn Header="Saldo (Rp)" Binding="{Binding Saldo, StringFormat=N0}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Kolom Kanan: Master Kategori Sampah -->
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Kelola Kategori Sampah" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NamaKategoriBaru}" Padding="6" Margin="0,0,4,0" ToolTip="Nama Kategori"/>
                                <TextBox Grid.Column="1" Text="{Binding HargaKategoriBaru}" Padding="6" Margin="0,0,4,0" ToolTip="Harga/kg"/>
                                <TextBox Grid.Column="2" Text="{Binding EmisiKategoriBaru}" Padding="6" Margin="0,0,4,0" ToolTip="Faktor Emisi CO2e"/>
                                <Button Grid.Column="3" Content="+ Simpan" Command="{Binding TambahKategoriCommand}" Padding="10,6" Background="#2E7D32" Foreground="White"/>
                            </Grid>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding DaftarKategori}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kategori" Binding="{Binding Nama}" Width="*"/>
                                <DataGridTextColumn Header="Harga/kg" Binding="{Binding HargaPerKg, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="Emisi CO2e" Binding="{Binding FaktorEmisiCO2e, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>